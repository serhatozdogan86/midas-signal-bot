# midas.env - Oracle VM ortam sablonu (render.yaml'in birebir karsiligi)
# KOPYALA: cp midas.env.example midas.env && chmod 600 midas.env
# Secrets'lari doldur. Bu dosya git'e GIRMEZ (.gitignore: ops/oracle/midas.env)
#
# PARALEL DOGRULAMA MODU (Faz 1): asagida "VERIFY:" ile isaretli satirlari
# ac, normallerini kapat -> tamamen sessiz, taze DB, gist'e DOKUNMAZ.
# KESIM (Faz 2): VERIFY satirlarini kapat, normalleri ac, DB'yi sil ->
# bot boot'ta gist'ten kanonik state'i kendisi restore eder.
#
# v4.26 KURAL - YORUMLAR AYRI SATIRDA: systemd EnvironmentFile satir sonu
# yorumunu DEGERIN PARCASI sayar ("PORT=8100  # not" -> PORT o copluk
# metnin tamami olur, servis kalkmaz). 9 Agu Faz 1 kurulumunda yerel
# Claude oturumu systemd-run olcumuyle yakaladi. Bu dosyada hicbir
# satirin SONUNA yorum yazma; aciklama bir UST satira, # ile.

# bybit botla cakismasin
PORT=8100
PYTHONUNBUFFERED=1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=DOLDUR
TELEGRAM_CHAT_ID=DOLDUR
# golge mod karari (v4.9) - Render'la ayni
TELEGRAM_ENABLED=false
TELEGRAM_ALERTS_ENABLED=true
# VERIFY (paralel kosuda cift uyari olmasin):
# VERIFY: TELEGRAM_ALERTS_ENABLED=false

# --- Veri kaynaklari ---
# Faz 1 icin AYRI ucretsiz anahtar kullan (Render'inkiyle kota paylasma)
FINNHUB_API_KEY=DOLDUR

# --- Evren / tarama (render.yaml ile birebir) ---
UNIVERSE_SOURCE=midas
UNIVERSE_MIN_DOLLAR_VOL=5000000
UNIVERSE_MIN_PRICE=3.0
COARSE_SCAN_INTERVAL_SEC=900
FINE_SCAN_INTERVAL_SEC=60
WATCHLIST_MAX=40
HTF=1d
MTF=1h
ATR_TP1_MULT=1.0
ATR_TP2_MULT=2.0
ATR_STOP_MULT=1.2
RISK_REWARD_MIN=2.0
MIN_TARGET_PCT=2.0
EARNINGS_BLACKOUT_DAYS=2
TIME_STOP_DAYS=4
SHORT_ENABLED=true
SEND_NO_TRADE=false

# --- State / yedek ---
STATE_BACKEND=sqlite
DB_PATH=data/bot.db
# VERIFY (taze defter, kanonik DB'ye dokunma):
# VERIFY: DB_PATH=data/verify.db
SHADOW_TRACKING=true
GIST_SYNC=true
# VERIFY (paralel kosu gist'e YAZMAZ):
# VERIFY: GIST_SYNC=false
# yalnizca 'gist' scope; Faz 1'de BOS birak (bos token = yazamaz)
GITHUB_TOKEN=DOLDUR
GIST_SYNC_INTERVAL_SEC=3600
GIST_CANDLE_MODE=signals

LOG_LEVEL=INFO
