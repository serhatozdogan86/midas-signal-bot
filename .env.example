# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Finnhub (ucretsiz plan: quote + earnings takvimi; OHLCV KAPALI)
FINNHUB_API_KEY=

# Evren
UNIVERSE_SOURCE=midas            # midas | static
UNIVERSE_MIN_DOLLAR_VOL=5000000
UNIVERSE_MIN_PRICE=3.0

# Tarama ritmi
COARSE_SCAN_INTERVAL_SEC=900     # 15 dk
HOURLY_FETCH_MAX=120             # 2. geciste 1h verisi cekilecek max aday
FINE_SCAN_INTERVAL_SEC=60        # Phase 2
WATCHLIST_MAX=40

# Zaman dilimleri
HTF=1d
MTF=1h

# Strateji
ATR_TP1_MULT=1.0
ATR_TP2_MULT=2.0
ATR_STOP_MULT=1.2
RISK_REWARD_MIN=2.0
MIN_TARGET_PCT=2.0               # maliyet filtresi (1.5$/islem gercegi)
EARNINGS_BLACKOUT_DAYS=2
TIME_STOP_DAYS=4
SHORT_ENABLED=true

# Yahoo rate limit ayarlari (Render paylasimli IP'lerinde onemli)
YF_CHUNK_SIZE=30
YF_CHUNK_PAUSE_SEC=2.0
YF_MAX_RETRIES=2
YF_BACKOFF_SEC=30

# Kalicilik
STATE_BACKEND=sqlite
DB_PATH=data/bot.db

# Faz 3: golge takip + gist yedekleme + dashboard
SHADOW_TRACKING=true
GITHUB_TOKEN=                    # SADECE 'gist' scope'lu token (repo yetkisi GEREKMEZ)
GIST_SYNC=true
GIST_ID=                         # bos = otomatik bul/olustur
GIST_SYNC_INTERVAL_SEC=3600
GIST_CANDLE_MODE=signals         # signals | off
FILL_WINDOW_BARS=14              # girise gelme suresi (~2 seans, 1h bar)
MAX_TRACK_BARS=28                # izleme suresi (~4 seans = time-stop)
