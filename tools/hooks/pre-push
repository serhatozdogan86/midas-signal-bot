#!/usr/bin/env bash
# pre-push: CLAUDE.md 2.5 (deploy penceresi) + 2.6 (yalnizca yesilse push)
# kurallarinin MEKANIK uygulanmasi.
#
# NEDEN (7 Agu karari): iki kural da yalniz disipline dayaniyordu; gecmiste
# iki kez kirik kod push'landi (2.6 notu) ve seans-ici deploy riski ancak
# hatirlamaya bagliydi. Repo dersi: "kural var" != "calisiyor" - bu dosya
# kurali davranisa cevirir. Davranis tests/test_prepush_hook.py ile OLCULUR.
#
# KURULUM (klon basina bir kez):  git config core.hooksPath tools/hooks
# v4.35: 2.5 ENGELI kaldirildi (kesim sonrasi main push deploy degil);
# seans kilidi deploy.sh'de yasar (asma yolu orada: --force). Bu kanca
# artik 2.6'yi zorlar + seans icinde bilgilendirir.
# SINIRLAR: --no-verify ile atlanabilir; yalniz kurulu klonu korur.
set -u

# --- 2.5 (v4.35, kesim sonrasi hizalama): main push artik deploy DEGILDIR.
# Render askida (12 Agu kesimi); dagitim VM'de deploy.sh ile yapilir ve
# seans kilidi ORADA, botun kendi takvimiyle (tatiller dahil) durur.
# Eski engel 17 Agu'da anayasayla celisir yakalandi (v4.31 kurali "main'e
# push seans icinde de serbesttir" derken kanca engelliyordu). Engel
# kaldirildi; seans icinde yalniz HATIRLATMA birakilir. ET uzerinden
# hesap (TR sabit UTC+3, ABD DST kullanir - CLAUDE.md 2.5).
push_main=0
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] && push_main=1
done
if [ "$push_main" = 1 ]; then
    dow=$(TZ=America/New_York date +%u)            # 1=Pzt ... 7=Paz
    hm=$((10#$(TZ=America/New_York date +%H%M)))   # 10#: "0930" octal sanilmasin
    if [ "$dow" -le 5 ] && [ "$hm" -ge 930 ] && [ "$hm" -lt 1600 ]; then
        echo "NOT (2.5): NYSE seansi acik. main push serbest (deploy degil);"
        echo "VM'ye cekme (deploy.sh) seans disina birakilir - kilit orada."
    fi
fi

# --- 2.6: testler - cikis kodu yutulmadan (&& zinciri yasagi), her push'ta.
# v4.26: repo kokunde .venv varsa onu kullan - VM kurulumunda (venv'li)
# sistem python3'unde pytest yok; hook yanlis "kirmizi" verip her push'u
# engelliyordu (9 Agu Faz 1 bulgusu). git hook'u repo kokunde calistirir.
PY="python3"
[ -x ".venv/bin/python" ] && PY=".venv/bin/python"
if ! "$PY" -m pytest -q >/tmp/prepush_pytest.log 2>&1; then
    echo "ENGEL (2.6): pytest kirmizi:"
    tail -20 /tmp/prepush_pytest.log
    exit 1
fi
if ! "$PY" -m pyflakes app/ >/tmp/prepush_pyflakes.log 2>&1; then
    echo "ENGEL (2.6): pyflakes:"
    cat /tmp/prepush_pyflakes.log
    exit 1
fi
exit 0
